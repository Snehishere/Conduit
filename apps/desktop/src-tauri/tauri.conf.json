{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conduit",
  "version": "0.1.0",
  "identifier": "app.conduit.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Conduit",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 720,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:9527 https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    },
    "trayIcon": {
      "iconPath": "icons/trayTemplate.png",
      "iconAsTemplate": true,
      "tooltip": "Conduit"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "./Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libasound2"]
      },
      "rpm": {
        "depends": ["alsa-lib"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
