# Generated / build outputs
target/
apps/mobile/build/
apps/mobile/.dart_tool/
apps/desktop/dist/
apps/desktop/node_modules/
.opencode/node_modules/
**/*.tsbuildinfo

# Vendored Windows OpenSSL (80 MB of .lib/.h). The relay image is Linux and
# links the system OpenSSL, so shipping it into the build context is pure
# waste. It was previously being copied in on every build.
.tools/

# Git metadata
.git/
.gitignore

# Dated audit archives - not needed in the image
docs/archive/

# IDE and tool caches
.idea/
.vscode/
*.DS_Store

# Sensitive / machine-specific (never ship into image)
.env
apps/mobile/android/local.properties
apps/mobile/ios/Flutter/Generated.xcconfig
apps/mobile/ios/Flutter/flutter_export_environment.sh
apps/mobile/ios/Flutter/ephemeral/

# Flutter plugin cache (machine-specific absolute paths)
apps/mobile/.flutter-plugins-dependencies

# Docs (not needed in Docker image)
*.md

# Stray artifacts. `video.mp4` was 76 MB and was being copied into every
# build context.
*.mp4
clippy_out.txt
scratch_*.ts
