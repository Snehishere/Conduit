# ─────────────────────────────────────────────────────────────────────────────
#  Conduit Relay Server
#
#  Copy to `.env` next to `docker-compose.yml` — compose reads this file.
#  Everything here is read by the relay process (`services/relay`), except the
#  compose-only port mapping at the bottom.
#
#  Full TLS / certificate / pinning instructions: docs/relay-tls.md
# ─────────────────────────────────────────────────────────────────────────────

# ─── Secrets ─────────────────────────────────────────────────────────────────

# REQUIRED. The bearer credential a client must present as `relay_token` in
# its `relay_auth` message.
#   openssl rand -hex 32
#
# This is an *authentication* credential only. It is NEVER used to sign or
# verify `relay_route` messages or binary frames — every client holds it, so
# using it as a MAC key would let any client forge a route on behalf of any
# other. Older versions of this file told you to set it equal to HMAC_SECRET;
# do not do that.
#
# Note: passed to the container as an environment variable, which means it is
# visible in `docker inspect` and `/proc/<pid>/environ`. Prefer the
# file-based path below if that matters to you.
RELAY_TOKEN=

# Master secret. Used for exactly two things:
#   1. seeding the derived message-signing key (see RELAY_SIGNING_KEY below)
#   2. the default bearer token for GET /health (see RELAY_HEALTH_TOKEN)
#
# Prefer the FILE form: leave HMAC_SECRET empty and mount a file, so the value
# never appears in the process environment.
#   openssl rand -hex 32 > hmac_secret && chmod 600 hmac_secret
# If neither HMAC_SECRET nor HMAC_SECRET_FILE is set, the relay generates a
# random secret on first start and persists it at $HMAC_SECRET_FILE. That path
# IS volume-mounted by docker-compose.yml, so it survives recreation.
HMAC_SECRET=

# Path to a file containing the master secret (one line, no quoting).
# Inside the compose container this resolves to the `relay-secrets` volume.
# Generate with:
#   openssl rand -hex 32 > ./secrets/hmac_secret && chmod 600 ./secrets/hmac_secret
HMAC_SECRET_FILE=/data/secrets/hmac_secret

# ─── Message signing (required by clients) ───────────────────────────────────

# Key used to HMAC `relay_route` messages and binary relay frames.
#
# LEAVE THIS UNSET for the normal case. The relay then derives the key from
# HMAC_SECRET with a domain-separated KDF:
#     HMAC-SHA256(HMAC_SECRET, "conduit-protocol/v1/derive:conduit-relay/v1/message-signing-key")
# which is cryptographically distinct from HMAC_SECRET and from RELAY_TOKEN.
#
# Set it explicitly only when you manage signing keys out-of-band. When you do,
# the relay uses this value verbatim — you must distribute the SAME value to
# your clients (see docs/relay-tls.md § Client configuration).
#   openssl rand -hex 32
# RELAY_SIGNING_KEY=

# `key_id` published in messages signed with RELAY_SIGNING_KEY.
# Default: v1
# RELAY_SIGNING_KEY_ID=v1

# ─── Key rotation ────────────────────────────────────────────────────────────
#
# Re-keying procedure (no client token is invalidated — RELAY_TOKEN is
# untouched by a re-key):
#
#   1. Generate the new key and a new id:
#        NEW_KEY=$(openssl rand -hex 32); NEW_ID="k$(date -u +%Y%m)"
#   2. Deploy it to clients FIRST (they must be able to sign with it).
#   3. Open the rotation window on the relay:
#        RELAY_SIGNING_KEY=<current key>
#        RELAY_SIGNING_KEY_ID=<current id>
#        RELAY_SIGNING_KEY_PREVIOUS=<new key>
#        RELAY_SIGNING_KEY_PREVIOUS_ID=<new id>
#      and restart the relay. During this window the relay ACCEPTS both keys
#      for verification, and signs nothing itself.
#   4. Once every client has been redeployed onto the new key (check
#      /metrics: conduit_relay_messages_dropped_total{reason="hmac_failed"}
#      must stay at 0), promote it:
#        RELAY_SIGNING_KEY=<new key>
#        RELAY_SIGNING_KEY_ID=<new id>
#      and remove both *_PREVIOUS* variables. The old key stops being accepted.
#   5. Confirm with GET /metrics that messages_dropped_total{reason="hmac_failed"}
#      is no longer rising, then you are done.
#
# A previous key MUST have an id: setting RELAY_SIGNING_KEY_PREVIOUS without
# RELAY_SIGNING_KEY_PREVIOUS_ID is a startup error, and the two ids must differ.
# RELAY_SIGNING_KEY_PREVIOUS=
# RELAY_SIGNING_KEY_PREVIOUS_ID=

# ─── TLS ─────────────────────────────────────────────────────────────────────
# See docs/relay-tls.md for the full runbook (bring-your-own-cert, ACME,
# renewal, pinning).

# Hostname clients use to reach this relay. Embedded as a SAN in the
# self-signed certificate generated on first boot.
# Without this the certificate is only valid for localhost / 127.0.0.1 / ::1
# and EVERY client fails hostname verification against a real deployment name.
#   e.g. RELAY_TLS_HOSTNAME=relay.example.com
RELAY_TLS_HOSTNAME=localhost

# Additional SANs, comma or space separated (alternate names, LAN address...).
# RELAY_TLS_EXTRA_SANS=relay2.example.com,10.0.0.5

# Directory holding cert.pem / key.pem. Mount a volume here to bring your own
# certificate. Inside the compose container this is the `relay-certs` volume.
# Certificates are read ONCE at startup: renewal requires a restart
# (`docker compose restart relay`).
RELAY_CERT_DIR=/data/certs

# ─── Ports ───────────────────────────────────────────────────────────────────
# In-container listen ports. The host mapping is at the bottom of this file.
RELAY_WS_PORT=9528
RELAY_WSS_PORT=9529
RELAY_HEALTH_PORT=9530

# Seconds a connection may stay open without authenticating. Default 10.
# RELAY_AUTH_TIMEOUT_SECS=10

# Plain (unencrypted) WebSocket. Sends the relay token in cleartext.
# Local testing only.
RELAY_ENABLE_PLAIN_WS=false

# ─── Replay protection ───────────────────────────────────────────────────────
# Path to the nonce replay cache. Written every 30 s and on shutdown.
# MUST be on a persistent volume: losing it voids the cross-restart replay
# guarantee (a replayed message inside the 30 s window becomes acceptable
# again after a restart). docker-compose.yml mounts /data for this.
#   Persisted keys are "<device_id>\x1f<nonce>"; the cache is scoped per
#   authenticated device and evicts oldest-first, never clearing wholesale.
RELAY_NONCE_FILE=/data/nonces.json

# ─── HTTP endpoints (health / metrics / pin) ────────────────────────────────

# Bearer token for GET /health and GET /.
# Defaults to HMAC_SECRET when unset. Set it explicitly so monitoring tools do
# not need the master secret.
# RELAY_HEALTH_TOKEN=

# Optional bearer token for GET /metrics.
# Unset by default: Prometheus scrapes /metrics without a credential. Setting
# this opts into requiring `Authorization: Bearer <token>` on /metrics too.
# RELAY_METRICS_TOKEN=

# Endpoints served on RELAY_HEALTH_PORT:
#   GET /healthz  liveness, unauthenticated (used by the compose healthcheck)
#   GET /health   counters JSON, requires the health bearer token
#   GET /metrics  Prometheus exposition; optionally token-gated
#   GET /pin      {"sha256":"sha256/<base64 SPKI pin>"} — certificate pin for
#                 clients. Read this instead of computing the pin by hand;
#                 see scripts/generate-cert-pin.sh.

# ─── Logging ─────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error
RUST_LOG=info

# ─── Docker Compose only (not read by the relay) ─────────────────────────────
# Host-side port mappings. Change these to publish on other host ports; the
# in-container ports above must still match the relay's configuration.
#   RELAY_PUBLISHED_WS_PORT=9528
#   RELAY_PUBLISHED_WSS_PORT=9529
#   RELAY_PUBLISHED_HEALTH_PORT=9530

# ─── Clients ─────────────────────────────────────────────────────────────────
# There are no build-time client env vars (the frontend cloud-relay VITE_*
# flags were removed). Clients read relay settings at runtime:
#   mobile  -> Settings (relayUrl / pinnedCertificate)
#   desktop -> Rust side (configurable relay URL is an open backlog item)
#
# Clients must be configured with:
#   * the relay URL matching RELAY_TLS_HOSTNAME
#   * the relay token (RELAY_TOKEN)
#   * the message-signing key (derived, or RELAY_SIGNING_KEY)
#   * the certificate pin from GET /pin  (see docs/relay-tls.md)
