        "content": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "source_device": {
          "type": "string"
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp (seconds)"
        }
      }
    },
