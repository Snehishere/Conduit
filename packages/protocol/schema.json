{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conduit.dev/protocol/schema.json",
  "title": "Conduit Wire Protocol",
  "description": "JSON message schema for the Conduit ecosystem (desktop, mobile, relay).",
  "definitions": {
    "DeviceInfo": {
      "type": "object",
      "description": "Device metadata exchanged during pairing and discovery.",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "phone",
            "tablet",
            "desktop"
          ]
        },
        "os": {
          "type": "string",
          "enum": [
            "ios",
            "android",
            "windows",
            "macos",
            "linux",
            "unknown"
          ]
        },
        "battery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "AutomationTrigger": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "device_connect",
            "device_disconnect",
            "time",
            "battery_level",
            "wifi_change",
            "app_open",
            "audio_device_connect",
            "audio_device_disconnect"
          ]
        },
        "device_id": {
          "type": "string"
        },
        "time": {
          "type": "string",
          "description": "HH:MM 24h format"
        },
        "below": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ssid": {
          "type": "string"
        },
        "app_package": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AutomationActionPayload": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "send_notification",
            "set_phone_profile",
            "route_audio",
            "run_shell_command",
            "toggle_wifi",
            "toggle_bluetooth",
            "open_url",
            "open_app",
            "set_window_state"
          ]
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "profile": {
          "type": "string",
          "enum": [
            "silent",
            "vibrate",
            "ring"
          ]
        },
        "device_id": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "app_package": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "minimize",
            "maximize",
            "restore",
            "close"
          ]
        }
      },
      "additionalProperties": false
    },
    "SmsMessage": {
      "type": "object",
      "description": "A single SMS record as produced by the phone.",
      "required": [
        "id",
        "address",
        "body",
        "timestamp",
        "read",
        "is_outgoing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable record ID; prefixed in_ for received, out_ for sent."
        },
        "address": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp (seconds)"
        },
        "read": {
          "type": "boolean"
        },
        "is_outgoing": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "SmsThread": {
      "type": "object",
      "description": "One conversation thread within an SMS Sync snapshot.",
      "required": [
        "thread_id",
        "address",
        "snippet",
        "unread_count",
        "timestamp",
        "messages"
      ],
      "properties": {
        "thread_id": {
          "type": "string",
          "description": "Stable thread ID; prefixed t_ on the originating phone."
        },
        "address": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Address-book display name, null when unresolved."
        },
        "snippet": {
          "type": "string"
        },
        "unread_count": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp (seconds) of the most recent message."
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SmsMessage"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "title": "Discovery Announce",
      "type": "object",
      "required": [
        "type",
        "action",
        "device_id",
        "device_name",
        "device_type"
      ],
      "properties": {
        "type": {
          "const": "discovery"
        },
        "action": {
          "const": "announce"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1
        },
        "device_id": {
          "type": "string"
        },
        "device_name": {
          "type": "string"
        },
        "device_type": {
          "type": "string",
          "enum": [
            "phone",
            "tablet",
            "desktop"
          ]
        },
        "os": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "battery": {
          "type": "integer"
        },
        "ws_port": {
          "type": "integer"
        },
        "wss_port": {
          "type": "integer"
        },
        "apns_token": {
          "type": "string"
        }
      }
    },
    {
      "title": "Discovery Remove",
      "type": "object",
      "required": [
        "type",
        "action",
        "device_id"
      ],
      "properties": {
        "type": {
          "const": "discovery"
        },
        "action": {
          "const": "remove"
        },
        "device_id": {
          "type": "string"
        }
      }
    },
    {
      "title": "Pairing Request",
      "type": "object",
      "required": [
        "type",
        "action",
        "token",
        "public_key"
      ],
      "properties": {
        "type": {
          "const": "pairing"
        },
        "action": {
          "const": "request"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "public_key": {
          "type": "string",
          "description": "X25519 public key, hex-encoded"
        },
        "device_info": {
          "$ref": "#/definitions/DeviceInfo"
        }
      }
    },
    {
      "title": "Pairing Accept",
      "type": "object",
      "required": [
        "type",
        "action",
        "public_key"
      ],
      "properties": {
        "type": {
          "const": "pairing"
        },
        "action": {
          "const": "accept"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1
        },
        "public_key": {
          "type": "string",
          "description": "X25519 public key, hex-encoded"
        },
        "device_info": {
          "$ref": "#/definitions/DeviceInfo"
        },
        "device_id": {
          "type": "string",
          "description": "The devices.id the desktop assigned to the peer. The peer stores it and sends it as source_device on every encrypted envelope; without it the receiver cannot resolve the shared secret. Absent when the sender predates assigned ids."
        },
        "hub_device_id": {
          "type": "string",
          "description": "The desktop's own device_id. A relayed v2 frame is verified under the sender's route key, and the sender's id is bound into that key's derivation, so a peer that does not know this cannot verify a relayed frame and must drop it. Absent when the sender predates it."
        },
        "relay_url": {
          "type": "string",
          "description": "A phone-facing address for the relay the desktop hosts, e.g. wss://192.168.1.50:9529. Always wss and never loopback: the plaintext listener is bound to 127.0.0.1 and carries the bearer token in clear. Absent when the desktop has no relay enabled, has not started it, or cannot determine a LAN address - absence is normal and must not be treated as an error."
        },
        "relay_token": {
          "type": "string",
          "description": "The relay's shared bearer credential. Presented once, in relay_auth, to open a connection; routing a frame additionally requires the sender's own route key, so holding this does not let a peer route as anyone else. Absent with relay_url."
        },
        "relay_cert_pin": {
          "type": "string",
          "description": "SPKI pin of the relay's OWN certificate, which is not the hub's - the relay generates its own TLS material. Must be kept in a separate slot from the hub's pin: a relay pin is never valid for the hub and vice versa. Absent with relay_url."
        }
      }
    },
    {
      "title": "Pairing Revoke",
      "type": "object",
      "required": [
        "type",
        "action"
      ],
      "properties": {
        "type": {
          "const": "pairing"
        },
        "action": {
          "const": "revoke"
        },
        "protocol_version": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string"
        }
      }
    },
    {
      "title": "Clipboard Sync",
